<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>a8b9c0d1e2f34a5b8c7d9e0f1a2b3c4d</uuid>
            <name>Templates/Network devices</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>b9c0d1e2f3a44b5c8d8e0f1a2b3c4d5e</uuid>
            <template>FortiSwitch 1024E - Complete SNMP</template>
            <name>FortiSwitch 1024E - Complete SNMP</name>
            <description>Clean FortiSwitch Complete SNMP Template with updated LLDP OIDs</description>
            <groups>
                <group>
                    <name>Templates/Network devices</name>
                </group>
            </groups>
            <items>
                <!-- System Serial Number -->
                <item>
                    <uuid>c0d1e2f3a4b54c6d8e0f1a2b3c4d5e6f</uuid>
                    <name>Hardware Serial Number</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.1.1.1.0</snmp_oid>
                    <key>fsSysSerial</key>
                    <delay>1h</delay>
                    <history>30d</history>
                    <value_type>TEXT</value_type>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>inventory</value>
                        </tag>
                    </tags>
                </item>
                <!-- Firmware Version -->
                <item>
                    <uuid>d1e2f3a4b5c64d7e8f1a2b3c4d5e6f7a</uuid>
                    <name>Firmware Version</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.4.1.1.0</snmp_oid>
                    <key>fsSysVersion</key>
                    <delay>1h</delay>
                    <history>30d</history>
                    <value_type>TEXT</value_type>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>system</value>
                        </tag>
                    </tags>
                </item>
                <!-- CPU Usage -->
                <item>
                    <uuid>e2f3a4b5c6d74e8f801a2b3c4d5e6f7a</uuid>
                    <name>CPU Usage</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.4.1.2.0</snmp_oid>
                    <key>fsSysCpuUsage</key>
                    <delay>1m</delay>
                    <history>30d</history>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>cpu</value>
                        </tag>
                    </tags>
                    <triggers>
                        <trigger>
                            <uuid>f3a4b5c6d7e84f9a812b3c4d5e6f7a8b</uuid>
                            <expression>last(/FortiSwitch 1024E - Complete SNMP/fsSysCpuUsage)&gt;85</expression>
                            <name>FortiSwitch High CPU Usage (&gt;85%)</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <!-- Memory Used -->
                <item>
                    <uuid>a1b2c3d4e5f64a7b8c9d0e1f2a3b4c5d</uuid>
                    <name>Memory Used</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.4.1.3.0</snmp_oid>
                    <key>fsSysMemUsage</key>
                    <delay>1m</delay>
                    <history>14d</history>
                    <units>B</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>1024</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>memory</value>
                        </tag>
                    </tags>
                </item>
                <!-- Memory Total -->
                <item>
                    <uuid>b2c3d4e5f6a74b8c9d0e1f2a3b4c5d6e</uuid>
                    <name>Memory Total</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.4.1.4.0</snmp_oid>
                    <key>fsSysMemCapacity</key>
                    <delay>1h</delay>
                    <history>14d</history>
                    <units>B</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>1024</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>memory</value>
                        </tag>
                    </tags>
                </item>
                <!-- Memory Utilization -->
                <item>
                    <uuid>c3d4e5f6a7b84c9d8e1f2a3b4c5d6e7f</uuid>
                    <name>Memory Utilization</name>
                    <type>CALCULATED</type>
                    <key>vm.memory.utilization</key>
                    <params>last(//fsSysMemUsage) / last(//fsSysMemCapacity) * 100</params>
                    <delay>1m</delay>
                    <history>30d</history>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>memory</value>
                        </tag>
                    </tags>
                    <triggers>
                        <trigger>
                            <uuid>d4e5f6a7b8c94d0e8f2a3b4c5d6e7f8a</uuid>
                            <expression>last(/FortiSwitch 1024E - Complete SNMP/vm.memory.utilization)&gt;90</expression>
                            <name>FortiSwitch High Memory Utilization (&gt;90%)</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <!-- Disk Space Used -->
                <item>
                    <uuid>e5f6a7b8c9d04e1f8a3b4c5d6e7f8a9b</uuid>
                    <name>Disk Space Used</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.4.1.5.0</snmp_oid>
                    <key>fsSysDiskUsage</key>
                    <delay>5m</delay>
                    <history>14d</history>
                    <units>B</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>1024</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>storage</value>
                        </tag>
                    </tags>
                </item>
                <!-- Disk Space Total -->
                <item>
                    <uuid>f6a7b8c9d0e14f2a8b4c5d6e7f8a9b0c</uuid>
                    <name>Disk Space Total</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.12356.106.4.1.6.0</snmp_oid>
                    <key>fsSysDiskCapacity</key>
                    <delay>1h</delay>
                    <history>14d</history>
                    <units>B</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>1024</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>storage</value>
                        </tag>
                    </tags>
                </item>
                <!-- System Uptime -->
                <item>
                    <uuid>a7b8c9d0e1f24a3b8c5d6e7f8a9b0c1d</uuid>
                    <name>System Uptime</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.2.1.1.3.0</snmp_oid>
                    <key>sysUpTime</key>
                    <delay>1m</delay>
                    <history>14d</history>
                    <units>uptime</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>0.01</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>system</value>
                        </tag>
                    </tags>
                </item>
            </items>
            <discovery_rules>
                <!-- Network Interfaces Discovery -->
                <discovery_rule>
                    <uuid>b8c9d0e1f2a34b4c8d6e7f8a9b0c1d2e</uuid>
                    <name>Network Interfaces Discovery</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#IFNAME},.1.3.6.1.2.1.31.1.1.1.1,{#IFDESCR},.1.3.6.1.2.1.2.2.1.2]</snmp_oid>
                    <key>net.if.discovery</key>
                    <delay>1h</delay>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>a1e2f3a4b5c64d7e8f9a0b1c2d3e4f5a</uuid>
                            <name>Interface {#IFNAME}: Speed</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.2.1.31.1.1.1.15.{#SNMPINDEX}</snmp_oid>
                            <key>net.if.speed[{#IFNAME}]</key>
                            <delay>5m</delay>
                            <history>14d</history>
                            <units>bps</units>
                            <preprocessing>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <parameters>
                                        <parameter>1000000</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>network</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c9d0e1f2a3b44c5d8e7f8a9b0c1d2e3f</uuid>
                            <name>Interface {#IFNAME}: Operational Status</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.2.1.2.2.1.8.{#SNMPINDEX}</snmp_oid>
                            <key>net.if.status[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>14d</history>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>network</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>d0e1f2a3b4c54d6e8f8a9b0c1d2e3f4a</uuid>
                                    <expression>last(/FortiSwitch 1024E - Complete SNMP/net.if.status[{#IFNAME}])=2 and change(/FortiSwitch 1024E - Complete SNMP/net.if.status[{#IFNAME}])&lt;&gt;0</expression>
                                    <name>Interface {#IFNAME}: Link Down</name>
                                    <priority>WARNING</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>e1f2a3b4c5d64e7f8a9b0c1d2e3f4a5b</uuid>
                            <name>Interface {#IFNAME}: Incoming Traffic</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.2.1.31.1.1.1.6.{#SNMPINDEX}</snmp_oid>
                            <key>net.if.in[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>14d</history>
                            <units>bps</units>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <parameters>
                                        <parameter>8</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>network</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f2a3b4c5d6e74f8a8b0c1d2e3f4a5b6c</uuid>
                            <name>Interface {#IFNAME}: Outgoing Traffic</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.2.1.31.1.1.1.10.{#SNMPINDEX}</snmp_oid>
                            <key>net.if.out[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>14d</history>
                            <units>bps</units>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <parameters/>
                                </step>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <parameters>
                                        <parameter>8</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>network</value>
                                </tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
                <!-- LLDP Neighbors Discovery (FortiSwitch Specific OID) -->
                <discovery_rule>
                    <uuid>b2c3d4e5f6a74b8c8d0e1f2a3b4c5d6e</uuid>
                    <name>LLDP Remote Devices Discovery</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#LLDP_REM_SYSNAME},.1.3.6.1.4.1.12356.106.10.1.1.4,{#LLDP_REM_PORT_ID},.1.3.6.1.4.1.12356.106.10.1.1.5]</snmp_oid>
                    <key>lldp.discovery</key>
                    <delay>30m</delay>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>c3d4e5f6a7b84c9d8e0f1a2b3c4d5e6f</uuid>
                            <name>LLDP Neighbor System Name: {#LLDP_REM_SYSNAME}</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.4.1.12356.106.10.1.1.4.{#SNMPINDEX}</snmp_oid>
                            <key>lldp.rem.sysname[{#SNMPINDEX}]</key>
                            <delay>30m</delay>
                            <history>14d</history>
                            <value_type>TEXT</value_type>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>lldp</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d4e5f6a7b8c94d0e8f1a2b3c4d5e6f7a</uuid>
                            <name>LLDP Neighbor Port: {#LLDP_REM_PORT_ID}</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.4.1.12356.106.10.1.1.5.{#SNMPINDEX}</snmp_oid>
                            <key>lldp.rem.port[{#SNMPINDEX}]</key>
                            <delay>30m</delay>
                            <history>14d</history>
                            <value_type>TEXT</value_type>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>lldp</value>
                                </tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>